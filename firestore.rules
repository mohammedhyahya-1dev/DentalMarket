rules_version = '2';

// Mirrors the admin allowlist in AuthRepository.kt (adminEmails). The app's
// isAdmin checks only hide buttons in the UI — these rules are what actually
// stop a non-admin client from reading or writing everyone else's data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in ['p.mohammed.h.yahya@gmail.com'];
    }

    // Cross-collection lookup so a rating write can be checked against the
    // order it claims to be for.
    function orderForRating(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    // users/{uid}: one profile doc per dentist.
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // listings/{id}: marketplace inventory, owned by sellerId.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // orders/{id}: buyers see their own; admins see and advance all.
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow get: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || isAdmin());
      allow list: if isAdmin() ||
        (isSignedIn() && resource.data.buyerId == request.auth.uid);
      // Only admins move an order through the fulfillment pipeline.
      allow update: if isAdmin();
      allow delete: if false;
    }

    // inquiries/{id}: buyers see their own questions; only admins see/answer all.
    match /inquiries/{inquiryId} {
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow get: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || isAdmin());
      allow list: if isAdmin() ||
        (isSignedIn() && resource.data.buyerId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // watchlist/{uid_listingId}: a buyer's own saved listings only.
    match /watchlist/{docId} {
      allow read, delete: if isSignedIn() && resource.data.buyerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if false;
    }

    // ratings/{orderId}: one rating per completed order, keyed by the orderId
    // itself (matches RatingRepository.submitRating). Reads are open to any
    // signed-in user since seller ratings are public browsing info, same as
    // listings — this is what lets the badge show on cards for every buyer,
    // not just the one who left the review.
    match /ratings/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.orderId == orderId &&
        request.resource.data.stars is int &&
        request.resource.data.stars >= 1 && request.resource.data.stars <= 5 &&
        orderForRating(orderId).buyerId == request.auth.uid &&
        orderForRating(orderId).status in ['DELIVERED', 'PAID_TO_SELLER'];
      // Immutable once submitted — matches the app's one-rating-per-order rule.
      allow update, delete: if false;
    }
  }
}
