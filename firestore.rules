rules_version = '2';

// Mirrors the admin allowlist in AuthRepository.kt (adminEmails). The app's
// isAdmin checks only hide buttons in the UI — these rules are what actually
// stop a non-admin client from reading or writing everyone else's data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Distinguishes a real account from a guest's anonymous-auth session —
    // request.auth.uid exists for both, so this is the only way to tell
    // them apart in rules. Mirrors FirebaseUser.isAnonymous on the client
    // (see AuthRepository.isAnonymous).
    function isNotGuest() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Backstop for the Sell and Checkout gates (see ListingViewModel.postListing
    // and CartViewModel.checkout, which both force-refresh the ID token via
    // AuthRepository.isEmailVerifiedFresh() right before writing, so this
    // claim reflects the same fresh state those client-side checks saw).
    // Anonymous users have no email at all, so this is false for them too —
    // no need to separately layer isNotGuest() alongside it.
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in ['p.mohammed.h.yahya@gmail.com'];
    }

    // Mirrors AuthRepository.isValidUsernameFormat/isUsernameAllowed exactly.
    // Used on every path that writes a username value — usernames/{name}'s
    // own doc id (the reservation), publicProfiles/{uid}.username (what
    // SellerProfileScreen shows OTHER users), and users/{userId}.username
    // (self-only-visible, but validated the same way for consistency and
    // because it's the source changeUsername's transaction copies from).
    // Real UX comes from the matching Kotlin checks running first, client-
    // side; these are the backstop — without them a raw write bypassing the
    // app could set any of the three straight to "admin".
    function isValidUsername(name) {
      return name.matches('^[a-zA-Z][a-zA-Z0-9_]{2,19}$');
    }

    function isReservedUsername(name) {
      return name.lower() in
        ['admin', 'administrator', 'support', 'dentalmarket', 'moderator', 'official'];
    }

    // Closes the gap format/reserved-word checks alone don't: without this,
    // any well-formed, non-reserved value passes, even one nobody actually
    // holds a usernames/{name} reservation for — two different accounts
    // could each set the identical public username. get()/exists() here
    // read the database as of the START of the CURRENT transaction/write,
    // never a write staged earlier in that same transaction (verified
    // empirically against the emulator) — so this only works because
    // AuthRepository's two-step writes always let the usernames/{name}
    // claim commit as its own transaction FIRST, before this document's
    // write is even attempted. A single transaction that tried to both
    // claim the reservation and satisfy this check could never work.
    function isOwnedUsername(value) {
      let normalized = value.lower();
      return exists(/databases/$(database)/documents/usernames/$(normalized)) &&
        get(/databases/$(database)/documents/usernames/$(normalized)).data.uid == request.auth.uid;
    }

    // users/{userId}.username specifically starts out blank — signUp()'s
    // initial DentalUser write and completeProfile()'s merge both predate
    // AuthRepository.ensureUsername() actually filling it in — so unlike
    // publicProfiles/{uid} (which the app only ever writes once it already
    // holds a real, validated value), this one has to accept "" too.
    function isValidOrBlankUsername(name) {
      return name == '' ||
        (isValidUsername(name) && !isReservedUsername(name) && isOwnedUsername(name));
    }

    // Cross-collection lookup, used wherever a write to another collection
    // needs to be checked against the order it claims to be for (ratings,
    // disputes, dispute-triggered sellerNotifications).
    function getOrder(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    // Gates the DELIVERED -> PAID_TO_SELLER transition below. OPEN holds up
    // the payout pending resolution; RESOLVED_BUYER holds it up permanently,
    // since that outcome means this order should never pay out.
    // RESOLVED_SELLER and DISMISSED both clear the block. Mirrors
    // disputeBlocksPayout() in OrderViewModel.kt exactly — keep the two in
    // sync if this ever changes. exists() first since most orders never
    // have a dispute doc at all.
    function disputeBlocksPayout(orderId) {
      return exists(/databases/$(database)/documents/disputes/$(orderId)) &&
        get(/databases/$(database)/documents/disputes/$(orderId)).data.status in ['OPEN', 'RESOLVED_BUYER'];
    }

    // Backstop for ContactInfoFilter.kt (client-side) so a modified client
    // can't bypass the off-platform-contact block by writing straight to
    // Firestore. This only catches the strict/compact forms (plain phone
    // numbers in either digit system, plain emails, and the clearest
    // call-me/whatsapp phrases) — the looser evasions (spaced-out or
    // spelled-out digits) aren't practical to express in RE2 and are left to
    // the client-side pass, which is the primary defense either way.
    function looksLikeContactInfo(text) {
      let t = text.lower();
      return
        t.matches('.*[a-z0-9._%+-]+@[a-z0-9-]+\\.[a-z]{2,}.*') ||
        t.matches('.*(0|٠)(7|٧)[0-9٠-٩]{9}.*') ||
        t.matches('.*(\\+|00)?964[0-9٠-٩]{10}.*') ||
        t.matches('.*(call me|text me|my number|phone number|whatsapp|whats app|contact me|reach me|message me on|dm me|viber|telegram|imo).*') ||
        t.matches('.*(رقمي|رقم هاتفي|اتصل بي|اتصلي بي|كلمني|خابرني|اطلبني|رنلي|رن لي|راسلني|تواصل معي|واتساب|واتس اب|واتسب|تليجرام|تلغرام|فايبر).*');
    }

    // users/{uid}: one profile doc per dentist. Restricted to self/admin
    // since this now holds deliveryAddress/deliveryContactPhone alongside
    // mobile/extraMobile — none of that should be readable by other buyers
    // or sellers. Public-facing info (name shown as "Posted by Dr. X", etc.)
    // is already denormalized onto listings/orders/ratings, so nothing else
    // in the app reads another user's doc.
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      // isValidOrBlankUsername covers the window between account creation
      // and AuthRepository.ensureUsername() actually filling this in — see
      // that function's own comment. Every other field on this doc (title,
      // mobile, deliveryAddress, ...) stays unvalidated here, same as before;
      // only username gets a rules-level check.
      allow create, update: if isSignedIn() && request.auth.uid == userId &&
        isValidOrBlankUsername(request.resource.data.username);
      allow delete: if false;
    }

    // listings/{id}: marketplace inventory, owned by sellerId. Posting and
    // editing both require a verified email (see ListingViewModel.postListing,
    // isEmailVerified() above) — a seller with unverified contact info isn't
    // someone buyers should be trusting money to. Applies to both create and
    // the owner's own update branch below, not to admin (privileged) or the
    // buyer/viewCount branches, which aren't "the seller editing their listing".
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid && isEmailVerified();
      // The owner or admin can change anything. A buyer who isn't the owner
      // can only flip an AVAILABLE listing to SOLD (nothing else) — this is
      // what CartViewModel.checkout() does right after placing an order, and
      // the app has no cross-collection way to verify the buyer actually
      // holds a matching order for this listing, so it's trusted as-is.
      // Same trust level for viewCount: any signed-in user (including
      // guests, who use anonymous auth) may nudge it by exactly +1 whenever
      // ProductDetailScreen opens — this is a display counter, not
      // something that needs to be tamper-proof, and there's no -1 since
      // views are never undone.
      allow update: if isSignedIn() &&
        ((resource.data.sellerId == request.auth.uid && isEmailVerified()) ||
         isAdmin() ||
         (resource.data.status == 'AVAILABLE' &&
          request.resource.data.status == 'SOLD' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) &&
          request.resource.data.viewCount == resource.data.viewCount + 1));
      allow delete: if isSignedIn() &&
        (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // orders/{id}: buyers and sellers see their own; admins see and advance
    // all. Sellers are read-only here — every mutation below is still
    // exclusively admin- or buyer-driven, unchanged by adding this read path.
    // Delivery address/phone are NOT on this document (see
    // orderDeliveryInfo/{orderId} below) specifically so this seller read
    // path can never expose them. Placing an order also requires a verified
    // email (see CartViewModel.checkout(), isEmailVerified() above) — same
    // reasoning as listings: real money is moving, so the account behind it
    // needs a reachable, verified contact.
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid && isEmailVerified();
      allow get: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid ||
         isAdmin());
      allow list: if isAdmin() ||
        (isSignedIn() &&
         (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid));
      // Admins can change anything (fulfillment status, payment
      // verify/reject) — EXCEPT moving DELIVERED -> PAID_TO_SELLER while
      // disputeBlocksPayout(orderId) (see that function above: an OPEN
      // dispute blocks pending resolution, RESOLVED_BUYER blocks
      // permanently); that one transition is where real money leaves the
      // platform, so it stays blocked, not just advanceStatus()'s
      // client-side check. A buyer who isn't admin can only submit their
      // own payment reference — moving AWAITING_PAYMENT or REJECTED to
      // PENDING_VERIFICATION — and only those three fields; they can never
      // set paymentStatus to VERIFIED themselves. A buyer can also confirm
      // their own SELLER_DELIVERS order arrived — moving PICKED_UP to
      // DELIVERED — but never for a DENTALMARKET_DELIVERS order, where only
      // admin (as courier) can advance that step.
      allow update: if
        (isAdmin() &&
         !(resource.data.status == 'DELIVERED' &&
           request.resource.data.status == 'PAID_TO_SELLER' &&
           disputeBlocksPayout(orderId))) ||
        (isSignedIn() && resource.data.buyerId == request.auth.uid &&
         resource.data.paymentStatus in ['AWAITING_PAYMENT', 'REJECTED'] &&
         request.resource.data.paymentStatus == 'PENDING_VERIFICATION' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['paymentReference', 'paymentStatus', 'paymentSubmittedAt'])) ||
        (isSignedIn() && resource.data.buyerId == request.auth.uid &&
         resource.data.deliveryMethod == 'SELLER_DELIVERS' &&
         resource.data.status == 'PICKED_UP' &&
         request.resource.data.status == 'DELIVERED' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'deliveryConfirmedAt']));
      allow delete: if false;
    }

    // orderDeliveryInfo/{orderId}: split out of orders/{orderId} specifically
    // so granting sellers read access to their own orders (above) can never
    // expose this — Firestore has no field-level redaction, so this split is
    // what makes "buyer/admin only" a rule-enforced guarantee rather than a
    // UI convention. Doc id matches the order's own id, same trick
    // ratings/{orderId} uses. Immutable once written, like every other
    // locked-at-checkout Order field.
    match /orderDeliveryInfo/{orderId} {
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow get: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || isAdmin());
      // Only admin ever queries this as a list (AdminOrdersScreen's batched
      // fetch); a buyer only ever fetches their own single known order by id.
      allow list: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // inquiries/{id}: buyers see their own questions; only admins see/answer all.
    match /inquiries/{inquiryId} {
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid &&
        !looksLikeContactInfo(request.resource.data.question);
      allow get: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || isAdmin());
      allow list: if isAdmin() ||
        (isSignedIn() && resource.data.buyerId == request.auth.uid);
      allow update: if isAdmin() && !looksLikeContactInfo(request.resource.data.answer);
      allow delete: if false;
    }

    // config/{docId}: app-wide settings (e.g. QiCard/ZainCash account
    // numbers) edited directly in the Firebase console — never through
    // the app, so no client write path at all.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // watchlist/{uid_listingId}: a buyer's own saved listings only.
    match /watchlist/{docId} {
      allow read, delete: if isSignedIn() && resource.data.buyerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if false;
    }

    // sellerNotifications/{id}: in-app notifications to a seller — the
    // original "here's who to deliver to" handoff (created only by the
    // verify-payment path, see OrderViewModel.verifyPayment, for
    // SELLER_DELIVERS orders) plus the two dispute notifications (see
    // model/SellerNotification.kt's type field). Carries the same buyer
    // address/phone as orders/{id}.deliveryAddress for the handoff variant,
    // so it gets the same care: only the intended seller (recipientId) or
    // admin can ever read one — never the buyer, never another seller.
    //
    // Creation is admin-only EXCEPT the DISPUTE_OPENED variant, which the
    // buyer's own client writes when they file a dispute — no admin action
    // is involved at that point. That path is deliberately narrow: type
    // must be exactly 'DISPUTE_OPENED', and a cross-collection lookup on
    // the order confirms the caller really is that order's buyer and
    // recipientId really is that order's seller, so a buyer can't spoof a
    // notification onto an unrelated order or a different recipient. There
    // is no free-text field on this path (see SellerNotification.kt) — the
    // rendered sentence lives in SellerNotificationsScreen's Kotlin, not in
    // the document, so this rule never has to validate message content.
    match /sellerNotifications/{id} {
      allow create: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.type == 'DISPUTE_OPENED' &&
         getOrder(request.resource.data.orderId).buyerId == request.auth.uid &&
         request.resource.data.recipientId == getOrder(request.resource.data.orderId).sellerId);
      allow get, list: if isSignedIn() &&
        (resource.data.recipientId == request.auth.uid || isAdmin());
      // The recipient can only flip their own notification to read — never
      // any other field, never someone else's notification.
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ratings/{orderId}: one rating per completed order, keyed by the orderId
    // itself (matches RatingRepository.submitRating). Reads are open to any
    // signed-in user since seller ratings are public browsing info, same as
    // listings — this is what lets the badge show on cards for every buyer,
    // not just the one who left the review.
    match /ratings/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.orderId == orderId &&
        request.resource.data.stars is int &&
        request.resource.data.stars >= 1 && request.resource.data.stars <= 5 &&
        getOrder(orderId).buyerId == request.auth.uid &&
        getOrder(orderId).status in ['DELIVERED', 'PAID_TO_SELLER'];
      // Immutable once submitted — matches the app's one-rating-per-order rule.
      allow update, delete: if false;
    }

    // reports/{reporterId_listingId}: buyer-filed moderation flags, purely
    // logged for admin to review — no in-app admin screen yet, the
    // Firebase Console is enough until report volume says otherwise.
    // Reporting is restricted to real accounts (isNotGuest), not just
    // signed-in ones, since an anonymous UID resets on reinstall and gives
    // moderation nothing to act on. Doc id is reporterId_listingId, the
    // same trick watchlist/{uid}_{listingId} uses, so a second report from
    // the same user for the same listing lands on the same doc — which
    // falls through to allow update below and is rejected there, since
    // only admin (flipping status) can ever update one of these.
    match /reports/{reportId} {
      allow create: if isNotGuest() &&
        request.resource.data.reporterId == request.auth.uid &&
        reportId == request.auth.uid + '_' + request.resource.data.listingId;
      allow get, list: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // follows/{followerId_followingId}: one doc per follower+seller pair,
    // same doc-id trick as watchlist/{uid}_{listingId}. followingId is
    // always a seller's uid (a person, not a listing).
    //
    // Reads are open to any signed-in user, same posture as ratings/{orderId}
    // above — follower/following counts on a Seller Profile screen are
    // public browsing info, and a count() aggregation query needs list-level
    // read access to be evaluated at all (it can't be scoped down to
    // "only your own follow docs" the way get() is on watchlist).
    //
    // Self-follow is rejected here, not just hidden by the UI never
    // rendering the button on your own listings — closes the write path
    // too. Immutable once created: unfollowing deletes the doc rather than
    // flipping a field, so there's nothing for allow update to permit.
    match /follows/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.followingId != request.auth.uid &&
        docId == request.auth.uid + '_' + request.resource.data.followingId;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // usernames/{normalizedName}: the uniqueness lock for DentalUser.username,
    // same doc-ID-as-reservation trick as follows/reports/watchlist above —
    // doc id is the lowercased/normalized username, content is just {uid}.
    // Firestore rules distinguish create (doc doesn't yet exist) from update
    // (doc exists) automatically, so a second claim on a taken name falls
    // through to `allow update: if false` below and is rejected — no
    // explicit existence check needed here. `get` is open to any signed-in
    // user since AuthRepository.changeUsername's transaction needs to read
    // the target name to see if it's free, and the auto-generation retry
    // loop needs the same for its own collision check.
    match /usernames/{name} {
      allow get: if isSignedIn();
      allow list: if false;
      // `name` here is the lowercased/normalized doc id (see
      // AuthRepository.normalizeUsername) — isValidUsername's pattern is
      // case-insensitive by construction (it just requires *a* letter
      // first), so checking the normalized id and the reserved list against
      // it are equivalent to checking the as-typed username.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid &&
        isValidUsername(name) && !isReservedUsername(name);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // publicProfiles/{uid}: the only piece of users/{uid} readable by anyone
    // other than the owner/admin — split out specifically so SellerProfileScreen
    // can show a seller's current username without widening users/{userId}'s
    // own rule (that document also holds deliveryAddress/mobile/etc., see its
    // comment above). Unlike Listing.sellerName/sellerProvince, a username is
    // user-editable after the fact, so it can't be a listing-time snapshot —
    // this is a live, always-current lookup instead. One doc per account,
    // holding only the public username.
    match /publicProfiles/{uid} {
      allow get: if isSignedIn();
      allow list: if false;
      // This is the field SellerProfileScreen shows to OTHER users, so
      // unlike users/{userId}.username below it's never legitimately blank
      // (the app only ever writes here once it already holds a real,
      // validated value) — no blank exception, always isValidUsername.
      // isOwnedUsername (see its own comment above) is what actually stops
      // two accounts from ending up with the identical public username.
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        isValidUsername(request.resource.data.username) &&
        !isReservedUsername(request.resource.data.username) &&
        isOwnedUsername(request.resource.data.username);
      allow delete: if false;
    }

    // disputes/{orderId}: one per order, keyed by the orderId itself (same
    // trick as ratings/{orderId}) — a second filing attempt lands on the
    // same doc, which falls through to allow update below and is rejected
    // there since only admin can update. Filing requires paymentStatus ==
    // VERIFIED (there's no real money on the line before that) but no
    // particular fulfillment stage otherwise, and no time window — same
    // "build fast" posture as reports/{reportId} above. This is the
    // document disputeBlocksPayout() reads to gate orders/{orderId}'s
    // DELIVERED -> PAID_TO_SELLER transition, so admin can never miss one:
    // resolving RESOLVED_SELLER or DISMISSED (get/list are admin-only,
    // matching AdminOrdersScreen's batched fetch) unblocks that payout;
    // resolving RESOLVED_BUYER blocks it permanently instead.
    match /disputes/{orderId} {
      allow create: if isSignedIn() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.orderId == orderId &&
        getOrder(orderId).buyerId == request.auth.uid &&
        getOrder(orderId).paymentStatus == 'VERIFIED';
      allow get: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt']);
      allow delete: if false;
    }
  }
}
